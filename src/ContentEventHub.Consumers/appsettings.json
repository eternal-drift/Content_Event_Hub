{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:19092",
    "SchemaRegistryUrl": "http://localhost:18081"
  },
  "SearchIndexer": {
    "Backpressure": {
      "Capacity": 1000,
      "ConcurrencyLimit": 8,
      "CommitIntervalMs": 5000
    },
    "ReplayFromBeginning": false
  },
  "NotificationForwarder": {
    "Backpressure": {
      "Capacity": 200,
      "ConcurrencyLimit": 8,
      "CommitIntervalMs": 250
    }
  },
  "Chaos": {
    "TransientFailureProbability": 0.0,
    "PermanentFailureProbability": 0.0
  }
}
